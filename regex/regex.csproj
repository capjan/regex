<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Authors>Jan Ruhlaender</Authors>
        <Company>Jan Ruhlaender</Company>
        <Version>2.0.0</Version>
        <Copyright>© Jan Ruhlaender. All rights reserved.</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Description>Regex command for the commandline.</Description>
        <PackageId>cap.regex</PackageId>
        <PackageTags>regex;cli;tool;dotnet-tool;grep</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryUrl>https://github.com/capjan/regex</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>regex</ToolCommandName>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="System.CommandLine" Version="2.0.12" />
        <InternalsVisibleTo Include="regex.Tests" />
        <None Include="..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
